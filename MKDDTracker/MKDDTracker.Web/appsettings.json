{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HistoricalImport": {
    "TimeTypePlausibility": {
      "MinimumSampleSize": 5,
      "SuspiciousRatio": 0.8,
      "FlapSuspiciousThresholdSeconds": 60,
      "ThreeLapSuspiciousThresholdSeconds": 45
    }
  },
  "AllowedHosts": "*"
}
