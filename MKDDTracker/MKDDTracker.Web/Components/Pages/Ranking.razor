@page "/ranking"
@rendermode InteractiveServer

@using MKDDTracker.Scraper.Models.Evolution
@using MKDDTracker.Scraper.Services.EvolutionService

@inject MkddHistoricalRankingSelectionService SelectionService
@inject MkddHistoricalRankingService RankingService

<PageTitle>Classements - MKDD Tracker</PageTitle>

<h1>Classements historiques</h1>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Circuit</label>
                <select class="form-select"
                        @bind="selectedCourse"
                        @bind:after="OnCriteriaChangedAsync">
                    @foreach (string course in courses)
                    {
                        <option value="@course">@course</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Date du classement</label>
                <InputDate class="form-control"
                           @bind-Value="selectedDate"
                           @bind-Value:after="OnDateChanged" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Type</label>
                <select class="form-select"
                        @bind="selectedTimeType"
                        @bind:after="OnCriteriaChangedAsync">
                    <option value="ThreeLap">ThreeLap</option>
                    <option value="Flap">Flap</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Fréquence</label>
                <select class="form-select"
                        @bind="selectedFrequency"
                        @bind:after="OnCriteriaChangedAsync">
                    <option value="@HistoricalFrequencyFilter.Hz50">50 Hz</option>
                    <option value="@HistoricalFrequencyFilter.Hz60">60 Hz</option>
                    <option value="@HistoricalFrequencyFilter.Unknown">Inconnue</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">Rechercher un joueur</label>
                <input class="form-control"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Nom du joueur..." />
            </div>

            <div class="col-12">
                <button class="btn btn-primary"
                        @onclick="ShowRankingAsync"
                        disabled="@(loading || !HasAvailableDates || string.IsNullOrWhiteSpace(selectedCourse))">
                    @(loading ? "Chargement..." : "Afficher le classement")
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (loading)
{
    <p>Chargement du classement historique...</p>
}
else if (courses.Count == 0)
{
    <div class="alert alert-info">Aucun circuit ne possède de performances historiques.</div>
}
else if (!HasAvailableDates)
{
    <div class="alert alert-info">Aucune performance historique n'est disponible pour ce circuit, ce type et cette fréquence.</div>
}
else if (rankingRequested && ranking is null)
{
    <div class="alert alert-info">Aucun joueur n'avait de performance connue à la fin de la journée sélectionnée.</div>
}
else if (ranking is not null)
{
    <div class="alert alert-secondary">
        <div><strong>Joueurs classés :</strong> @ranking.Entries.Count</div>
        <div><strong>Circuit :</strong> @ranking.CourseName</div>
        <div><strong>Date demandée :</strong> @selectedDate.ToString("dd/MM/yyyy")</div>
        <div><strong>Type :</strong> @ranking.TimeType</div>
        <div><strong>Fréquence :</strong> @FrequencyLabel</div>
        <div><strong>Premier PR disponible :</strong> @FormatDate(availableDateRange!.FirstSeenAt)</div>
        <div><strong>Dernier PR disponible :</strong> @FormatDate(availableDateRange!.LastSeenAt)</div>
    </div>

    <p class="text-muted">
        Le classement est reconstruit à partir du dernier PR connu de chaque joueur à la date sélectionnée.
        Les dates correspondent aux premières observations connues dans les sources historiques.
    </p>

    @if (availableDateRange!.Count == 1)
    {
        <div class="alert alert-info">Une seule performance historique est disponible pour ces critères.</div>
    }

    @if (!FilteredEntries.Any())
    {
        <div class="alert alert-info">Aucun joueur ne correspond à cette recherche.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Rang</th>
                        <th>Joueur</th>
                        <th>Chrono</th>
                        <th>Pays</th>
                        <th>Date du PR connu</th>
                        <th>Source / rattachement</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MkddHistoricalRankingEntry entry in FilteredEntries)
                    {
                        <tr>
                            <td>#@entry.Rank</td>
                            <td>
                                @if (entry.PlayerId is not null)
                                {
                                    <a href="@GetPlayerUrl(entry.PlayerName)" class="text-decoration-none fw-semibold">
                                        @entry.PlayerName
                                    </a>
                                }
                                else
                                {
                                    <span class="fw-semibold">@entry.PlayerName</span>
                                }
                            </td>
                            <td>@FormatRaceTime(entry.Time)</td>
                            <td>@(entry.Country ?? "—")</td>
                            <td>@FormatDate(entry.FirstSeenAt)</td>
                            <td>
                                @if (entry.PlayerId is not null)
                                {
                                    <span class="badge text-bg-primary">Joueur MKDDTracker</span>
                                    <small class="d-block text-muted">@entry.ExternalName</small>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Alias historique</span>
                                    <small class="d-block text-muted">@entry.ExternalName</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <div class="alert alert-info">Sélectionnez les critères puis affichez le classement historique.</div>
}

@code {
    private List<string> courses = [];
    private string selectedCourse = "";
    private string selectedTimeType = "ThreeLap";
    private HistoricalFrequencyFilter selectedFrequency = HistoricalFrequencyFilter.Hz60;
    private DateTime selectedDate = DateTime.Today;
    private HistoricalPerformanceDateRange? availableDateRange;
    private MkddHistoricalRanking? ranking;
    private string searchText = "";
    private string? errorMessage;
    private bool loading;
    private bool rankingRequested;

    private bool HasAvailableDates =>
        availableDateRange?.FirstSeenAt is not null &&
        availableDateRange.LastSeenAt is not null;

    private string FrequencyLabel => selectedFrequency switch
    {
        HistoricalFrequencyFilter.Hz50 => "50 Hz",
        HistoricalFrequencyFilter.Hz60 => "60 Hz",
        HistoricalFrequencyFilter.Unknown => "Inconnue",
        _ => "Inconnue"
    };

    private IEnumerable<MkddHistoricalRankingEntry> FilteredEntries =>
        ranking?.Entries.Where(entry =>
            string.IsNullOrWhiteSpace(searchText) ||
            entry.PlayerName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        ?? [];

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            courses = await SelectionService.GetCoursesAsync();
            selectedCourse = courses.FirstOrDefault() ?? "";
            if (!string.IsNullOrWhiteSpace(selectedCourse))
                await LoadDateRangeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnCriteriaChangedAsync()
    {
        ranking = null;
        rankingRequested = false;
        errorMessage = null;
        loading = true;
        try
        {
            await LoadDateRangeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void OnDateChanged()
    {
        ranking = null;
        rankingRequested = false;
        errorMessage = null;
    }

    private async Task LoadDateRangeAsync()
    {
        availableDateRange = null;
        if (string.IsNullOrWhiteSpace(selectedCourse))
            return;

        availableDateRange = await SelectionService.GetDateRangeAsync(
            selectedCourse,
            selectedTimeType,
            selectedFrequency);

        if (availableDateRange.LastSeenAt is DateTimeOffset latest)
            selectedDate = latest.ToUniversalTime().Date;
    }

    private async Task ShowRankingAsync()
    {
        ranking = null;
        rankingRequested = true;
        errorMessage = null;

        if (!HasAvailableDates || string.IsNullOrWhiteSpace(selectedCourse))
            return;

        loading = true;
        try
        {
            DateTimeOffset rankingAt = new(
                selectedDate.Date.AddDays(1).AddTicks(-1),
                TimeSpan.Zero);

            ranking = await RankingService.GetRankingAtAsync(
                selectedCourse,
                selectedTimeType,
                selectedFrequency,
                rankingAt);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static string GetPlayerUrl(string playerName) =>
        $"/joueurs?player={Uri.EscapeDataString(playerName)}";

    private static string FormatRaceTime(TimeSpan time) =>
        $"{(int)time.TotalMinutes}:{time.Seconds:00}.{time.Milliseconds:000}";

    private static string FormatDate(DateTimeOffset? date) =>
        date is null
            ? "—"
            : date.Value.ToUniversalTime().ToString("dd/MM/yyyy");
}
