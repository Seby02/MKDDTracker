@page "/evolution"
@rendermode InteractiveServer

@using MKDDTracker.Web.Components.Charts
@using Microsoft.EntityFrameworkCore
@using MKDDTracker.Scraper.Data.Database
@using MKDDTracker.Scraper.Models.Evolution
@using MKDDTracker.Scraper.Services.EvolutionService

@inject MkddHistoricalRankingSelectionService SelectionService
@inject MkddHistoricalRankingComparisonService ComparisonService
@inject MkddHistoricalPlayerTimelineService TimelineService
@inject MkddHistoricalMultiPlayerComparisonService MultiPlayerComparisonService

<PageTitle>Évolution - MKDD Tracker</PageTitle>

<h1>Évolution des joueurs</h1>

<div class="card mb-4">
    <div class="card-body">
        <h4 class="mb-3">Critères d'analyse historique</h4>
        <div class="mb-3">
            <label class="form-label d-block">
                Mode d'analyse
            </label>

            <div class="btn-group"
                 role="group"
                 aria-label="Mode d'analyse">
                <button type="button"
                        class="@GetAnalysisModeButtonClass(false)"
                        @onclick="() => SetAnalysisModeAsync(false)"
                        disabled="@loading">
                    Joueur unique
                </button>

                <button type="button"
                        class="@GetAnalysisModeButtonClass(true)"
                        @onclick="() => SetAnalysisModeAsync(true)"
                        disabled="@loading">
                    Comparaison multi-joueurs
                </button>
            </div>
        </div>
        <div class="row g-3">
            @if (!isMultiPlayerMode)
            {
                <div class="col-md-6">
                    <label class="form-label">Joueur</label>

                    <select class="form-select"
                            @bind="selectedPlayerKey"
                            @bind:after="OnCriteriaChangedAsync">
                        @foreach (HistoricalPlayerOption player in players)
                        {
                            <option value="@player.Key">
                                @player.DisplayName
                            </option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="col-12">
                    <label class="form-label">
                        Joueurs à comparer
                    </label>

                    <div class="card">
                        <div class="card-body">
                            <p class="text-muted small">
                                Sélectionnez entre 2 et 4 joueurs modernes.
                                Les alias historiques liés à chaque joueur seront
                                automatiquement consolidés.
                            </p>

                            <div class="row g-2">
                                @foreach (HistoricalPlayerOption player
                                                            in modernPlayers)
                                {
                                    int playerId = player.PlayerId!.Value;

                                    <div class="col-md-6 col-lg-4">
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="@($"multi-player-{playerId}")"
                                                   checked="@selectedMultiPlayerIds.Contains(playerId)"
                                                   disabled="@IsMultiPlayerSelectionDisabled(playerId)"
                                                   @onchange="eventArgs =>
                                                   OnMultiPlayerChangedAsync(
                                                       playerId,
                                                       eventArgs)" />

                                    <label class="form-check-label"
                                           for="@($"multi-player-{playerId}")">
                                        @player.DisplayName
                                    </label>
                                </div>
                            </div>
                                                        }
                            </div>

                            <div class="small mt-3 @GetMultiPlayerSelectionClass()">
                                @GetMultiPlayerSelectionMessage()
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="col-md-6">
                <label class="form-label">Circuit</label>
                <select class="form-select" @bind="selectedCourse" @bind:after="OnCriteriaChangedAsync">
                    @foreach (var course in courses)
                    {
                        <option value="@course">@course</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Type de chrono</label>
                <select class="form-select" @bind="selectedTimeType" @bind:after="OnCriteriaChangedAsync">
                    <option value="ThreeLap">ThreeLap</option>
                    <option value="Flap">Flap</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Fréquence</label>
                <select class="form-select" @bind="selectedFrequency" @bind:after="OnCriteriaChangedAsync">
                    <option value="@HistoricalFrequencyFilter.Hz50">50 Hz</option>
                    <option value="@HistoricalFrequencyFilter.Hz60">60 Hz</option>
                    <option value="@HistoricalFrequencyFilter.Unknown">Inconnue</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Date de début</label>
                <InputDate class="form-control" @bind-Value="startDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Date de fin</label>
                <InputDate class="form-control" @bind-Value="endDate" />
            </div>
            <div class="col-12">
                <button class="btn btn-primary"
                        @onclick="AnalyzeAsync"
                        disabled="@(!CanAnalyze)">
                    @(loading ? "Analyse en cours..." : "Analyser")
                </button>
            </div>
            <div class="col-12 text-muted">
                @if (!isMultiPlayerMode)
                {
                    <strong>PR historiques disponibles :</strong>
                    <span>@availableHistoricalCount</span>
                }
                else
                {
                    <strong>Joueurs sélectionnés :</strong>
                    <span>@($"{selectedMultiPlayerIds.Count} / 4")</span>
                }

                <div class="small">
                    La date correspond à la première publication connue dans
                    les archives Yahoo ; elle ne représente pas nécessairement
                    la date de réalisation du chrono.
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (loading)
{
    <p>Chargement de l'évolution...</p>
}
else if (isMultiPlayerMode &&
         multiPlayerComparison is null)
{
    <div class="alert alert-info">
        Sélectionnez entre 2 et 4 joueurs, puis lancez l'analyse.
    </div>
}
else if (isMultiPlayerMode)
{
    <h2>
        Comparaison multi-joueurs —
        @multiPlayerComparison!.CourseName
    </h2>

    <p class="text-muted">
        @multiPlayerComparison.TimeType,
        @FormatFrequency(multiPlayerComparison.FrequencyFilter),
        du @multiPlayerComparison.StartDate.ToString("dd/MM/yyyy")
        au @multiPlayerComparison.EndDate.ToString("dd/MM/yyyy")
    </p>

    @if (multiPlayerComparison.Players.Count == 0)
    {
        <div class="alert alert-warning">
            Aucun des joueurs sélectionnés ne dispose de données
            pour ces critères.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Joueur</th>
                        <th>Chrono initial</th>
                        <th>Chrono final</th>
                        <th>Gain chrono</th>
                        <th>Rang initial</th>
                        <th>Rang final</th>
                        <th>Places</th>
                        <th>PR</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (
                                MkddHistoricalPlayerComparisonEntry player
                                in multiPlayerComparison.Players)
                    {
                        <tr>
                            <td>
                                <strong>@player.PlayerName</strong>

                                @if (player.IsNewEntry)
                                {
                                    <span class="badge text-bg-info ms-1">
                                        Nouvel entrant
                                    </span>
                                }
                            </td>

                            <td>
                                @FormatRaceTime(player.InitialTime)
                            </td>

                            <td>
                                @FormatRaceTime(player.FinalTime)
                            </td>

                            <td class="@GetTimeImprovementClass(
                                                                                                player.TimeImprovement)">
                    @FormatTimeImprovement(
                                        player.TimeImprovement)
                </td>

                <td>
                    @FormatRank(player.InitialRank)
                </td>

                <td>
                    @FormatRank(player.FinalRank)
                </td>

                <td class="@GetPlacesClass(
                                                                        player.PlacesGained)">
                    @FormatPlaces(player.PlacesGained)
                </td>

                            <td>
                                @player.PrCount
                            </td>
                        </tr>
                        }
                </tbody>
            </table>
        </div>

        <div class="alert alert-secondary mt-3">
            Les graphiques multi-joueurs seront ajoutés dans
            l'étape suivante. Les graphiques actuels restent
            disponibles en mode joueur unique.
        </div>
    }
}
else if (comparison is null)
{
    <div class="alert alert-info">
        Sélectionnez des critères disposant de données historiques.
    </div>
}
else
{
    var entry = selectedEntry;

    <h2>
        @(entry?.PlayerName
            ?? selectedPlayer?.DisplayName
            ?? "Joueur")
    —
    @comparison.CourseName
</h2>

@if (entry is null ||
         entry.Status ==
            MkddHistoricalRankingComparisonStatus.Unavailable)
    {
        <div class="alert alert-warning">
            Le classement historique n'est pas disponible
            pour ces critères.
        </div>
    }
    else
    {
        @if (entry.Status ==
                     MkddHistoricalRankingComparisonStatus.NewEntrant)
        {
            <div class="alert alert-info">
                Ce joueur est un nouvel entrant :
                il n'apparaît pas dans le classement initial.
            </div>
        }
        else if (entry.Status ==
                 MkddHistoricalRankingComparisonStatus.MissingAtEnd)
        {
            <div class="alert alert-warning">
                Ce joueur n'apparaît plus dans le classement final.
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h6>Rang initial</h6>
                        <h2>@FormatRank(entry.InitialRank)</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h6>Rang final</h6>
                        <h2>@FormatRank(entry.FinalRank)</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h6>Progression totale</h6>
                        <h2>@FormatPlaces(entry.PlacesGained)</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h6>Chrono final</h6>
                        <h2>@FormatRaceTime(entry.FinalTime)</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5>Détail de la comparaison</h5>

                <p>
                    Statut :
                    <strong>@entry.Status</strong>
                </p>

                <p>
                    Rang :
                    <strong>
                        @FormatRank(entry.InitialRank)
                        →
                        @FormatRank(entry.FinalRank)
                    </strong>
                    (@FormatPlaces(entry.PlacesGained))
                </p>

                <p>
                    Chrono :
                    <strong>
                        @FormatRaceTime(entry.InitialTime)
                        →
                        @FormatRaceTime(entry.FinalTime)
                    </strong>
                </p>

                <p>
                    Temps gagné/perdu :
                    <strong>
                        @FormatTimeImprovement(
                        entry.TimeImprovement)
            </strong>
        </p>
    </div>
</div>
    }

    <section class="mt-4">
        <h3>Évolution historique</h3>

        @if (timeline is null ||
            timeline.Points.Count == 0)
        {
            <div class="alert alert-info">
                Aucun point de chronologie n'est disponible
                pour ces critères.
            </div>
        }
        else
        {
            <div class="table-responsive mb-4">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Chrono</th>
                            <th>Gain chrono</th>
                            <th>Rang</th>
                            <th>Variation de rang</th>
                            <th>Source(s)</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (
                                        MkddHistoricalPlayerTimelinePoint point
                                        in timeline.Points)
                        {
                            <tr>
                                <td>
                                    @point.Date.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @FormatRaceTime(point.Time)
                                </td>

                                <td class="@GetTimeImprovementClass(
                                                                        point.TimeImprovement)">
                        @FormatTimeImprovement(
                                                point.TimeImprovement)
                    </td>

                    <td>
                        #@point.Rank
                    </td>

                    <td class="@GetPlacesClass(
                                                            point.PlacesGained)">
                        @FormatPlaces(
                                                point.PlacesGained)
                    </td>

                    <td>
                        @foreach (
                                                string source
                                                in point.Sources)
                                    {
                                        <span class="badge @GetSourceBadgeClass(source) me-1">
                                            @source
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (timeline.Points.Count == 1)
            {
                <p class="text-muted">
                    Un seul point est disponible :
                    il n'y a pas suffisamment d'évolution
                    pour tracer une progression.
                </p>
            }
            else
            {
                <MkddHistoricalTimeEvolutionChart Points="timeline.Points" />

                <MkddHistoricalRankEvolutionChart Points="timeline.Points" />
            }
        }
    </section>
}

@code {
    private List<HistoricalPlayerOption> players = [];
    private List<string> courses = [];
    private bool isMultiPlayerMode;
    private HashSet<int> selectedMultiPlayerIds = [];
    private MkddHistoricalMultiPlayerComparison? multiPlayerComparison;
    private string selectedPlayerKey = "";
    private string selectedCourse = "";
    private string selectedTimeType = "ThreeLap";
    private HistoricalFrequencyFilter selectedFrequency = HistoricalFrequencyFilter.Hz60;
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today;
    private int availableHistoricalCount;
    private MkddHistoricalRankingComparison? comparison;
    private MkddHistoricalPlayerTimeline? timeline;
    private bool loading;
    private string? errorMessage;

    [SupplyParameterFromQuery(Name = "player")]
    private string? PlayerFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "course")]
    private string? CourseFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    private string? TimeTypeFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "frequency")]
    private string? FrequencyFromQuery { get; set; }

    private HistoricalPlayerOption? selectedPlayer =>
        players.FirstOrDefault(player => player.Key == selectedPlayerKey);

    private MkddHistoricalRankingComparisonEntry? selectedEntry =>
        comparison?.Entries.FirstOrDefault(entry =>
            selectedPlayer?.PlayerId is not null
                ? entry.PlayerId == selectedPlayer.PlayerId
                : entry.HistoricalPlayerAliasId == selectedPlayer?.HistoricalPlayerAliasId);

    private bool AreDatesValid => startDate.Date <= endDate.Date;

    private bool HasValidMultiPlayerSelection =>
    selectedMultiPlayerIds.Count is >= 2 and <= 4;

    private bool CanAnalyze =>
    !loading &&
    AreDatesValid &&
    !string.IsNullOrWhiteSpace(selectedCourse) &&
    (
        isMultiPlayerMode
            ? HasValidMultiPlayerSelection
            : selectedPlayer is not null &&
              availableHistoricalCount > 0
    );

    private IReadOnlyList<HistoricalPlayerOption> modernPlayers =>
    players
        .Where(player =>
            player.PlayerId.HasValue)
        .OrderBy(player =>
            player.DisplayName,
            StringComparer.OrdinalIgnoreCase)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            players = await SelectionService.GetPlayersAsync();
            courses = await SelectionService.GetCoursesAsync();
            selectedPlayerKey = ResolvePlayerKey(PlayerFromQuery) ?? players.FirstOrDefault()?.Key ?? "";
            selectedCourse = courses.Contains(CourseFromQuery ?? "")
                ? CourseFromQuery!
                : courses.FirstOrDefault() ?? "";
            selectedTimeType = ResolveTimeType(TimeTypeFromQuery) ?? selectedTimeType;
            selectedFrequency = ResolveFrequency(FrequencyFromQuery) ?? selectedFrequency;
            await LoadAvailableDatesAsync();
            if (availableHistoricalCount >= 2)
                await AnalyzeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SetAnalysisModeAsync(
    bool multiPlayerMode)
    {
        if (isMultiPlayerMode == multiPlayerMode)
        {
            return;
        }

        isMultiPlayerMode =
            multiPlayerMode;

        errorMessage =
            null;

        comparison =
            null;

        timeline =
            null;

        multiPlayerComparison =
            null;

        if (isMultiPlayerMode)
        {
            InitializeMultiPlayerSelection();
        }

        await LoadAvailableDatesAsync();
    }

    private void InitializeMultiPlayerSelection()
    {
        selectedMultiPlayerIds.Clear();

        HistoricalPlayerOption? currentPlayer =
            selectedPlayer;

        if (currentPlayer?.PlayerId is not null)
        {
            selectedMultiPlayerIds.Add(
                currentPlayer.PlayerId.Value);
        }

        foreach (HistoricalPlayerOption player
                 in modernPlayers)
        {

            if (selectedMultiPlayerIds.Count >= 2)
            {
                break;
            }

            selectedMultiPlayerIds.Add(
                player.PlayerId!.Value);

        }
    }

    private async Task OnMultiPlayerChangedAsync(
    int playerId,
    ChangeEventArgs eventArgs)
    {
        bool isSelected =
            eventArgs.Value is bool value &&
            value;

        if (isSelected)
        {
            if (selectedMultiPlayerIds.Count < 4)
            {
                selectedMultiPlayerIds.Add(
                    playerId);
            }
        }
        else
        {
            selectedMultiPlayerIds.Remove(
                playerId);
        }

        errorMessage =
            null;

        multiPlayerComparison =
            null;

        await LoadAvailableDatesAsync();
    }

    private bool IsMultiPlayerSelectionDisabled(
        int playerId) =>
        loading ||
        (
            !selectedMultiPlayerIds.Contains(playerId) &&
            selectedMultiPlayerIds.Count >= 4
        );

    private string GetMultiPlayerSelectionMessage()
    {
        int count =
            selectedMultiPlayerIds.Count;

        return count switch
        {
            0 =>
                "Sélectionnez au moins deux joueurs.",

            1 =>
                "Sélectionnez encore un joueur.",

            >= 2 and <= 4 =>
                $"{count} joueurs sélectionnés.",

            _ =>
                "Quatre joueurs maximum."
        };
    }

    private string GetMultiPlayerSelectionClass() =>
        HasValidMultiPlayerSelection
            ? "text-success"
            : "text-danger";

    private string GetAnalysisModeButtonClass(
        bool multiPlayerMode) =>
        isMultiPlayerMode == multiPlayerMode
            ? "btn btn-primary"
            : "btn btn-outline-primary";

    private string? ResolvePlayerKey(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        return players.FirstOrDefault(player =>
            string.Equals(player.Key, value, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(player.DisplayName, value, StringComparison.OrdinalIgnoreCase))?.Key;
    }

    private static string? ResolveTimeType(string? value) =>
        string.Equals(value, "ThreeLap", StringComparison.OrdinalIgnoreCase)
            ? "ThreeLap"
            : string.Equals(value, "Flap", StringComparison.OrdinalIgnoreCase)
                ? "Flap"
                : null;

    private static HistoricalFrequencyFilter? ResolveFrequency(string? value) =>
        Enum.TryParse(value, ignoreCase: true, out HistoricalFrequencyFilter frequency) &&
        frequency is HistoricalFrequencyFilter.Hz50 or HistoricalFrequencyFilter.Hz60 or HistoricalFrequencyFilter.Unknown
            ? frequency
            : null;

    private async Task OnCriteriaChangedAsync()
    {
        errorMessage =
            null;

        comparison =
            null;

        timeline =
            null;

        multiPlayerComparison =
            null;

        await LoadAvailableDatesAsync();
    }

    private async Task LoadAvailableDatesAsync()
    {
        availableHistoricalCount =
            0;

        if (string.IsNullOrWhiteSpace(selectedCourse))
        {
            return;
        }

        if (!isMultiPlayerMode)
        {
            if (selectedPlayer is null)
            {
                return;
            }

            HistoricalPerformanceDateRange range =
                await SelectionService.GetDateRangeAsync(
                    selectedPlayer,
                    selectedCourse,
                    selectedTimeType,
                    selectedFrequency);

            availableHistoricalCount =
                range.Count;

            if (range.FirstSeenAt is not null &&
                range.LastSeenAt is not null)
            {
                startDate =
                    range.FirstSeenAt.Value.Date;

                endDate =
                    range.LastSeenAt.Value.Date;
            }

            return;
        }

        DateTimeOffset? earliest =
            null;

        DateTimeOffset? latest =
            null;

        int totalCount =
            0;

        foreach (HistoricalPlayerOption player
                 in modernPlayers.Where(player =>
                     selectedMultiPlayerIds.Contains(
                         player.PlayerId!.Value)))
        {
            HistoricalPerformanceDateRange range =
                await SelectionService.GetDateRangeAsync(
                    player,
                    selectedCourse,
                    selectedTimeType,
                    selectedFrequency);

            totalCount +=
                range.Count;

            if (range.FirstSeenAt is not null &&
                (
                    earliest is null ||
                    range.FirstSeenAt.Value < earliest.Value
                ))
            {
                earliest =
                    range.FirstSeenAt.Value;
            }

            if (range.LastSeenAt is not null &&
                (
                    latest is null ||
                    range.LastSeenAt.Value > latest.Value
                ))
            {
                latest =
                    range.LastSeenAt.Value;
            }
        }

        availableHistoricalCount =
            totalCount;

        if (earliest is not null &&
            latest is not null)
        {
            startDate =
                earliest.Value.Date;

            endDate =
                latest.Value.Date;
        }
    }

    private async Task AnalyzeAsync()
    {
        if (loading)
        {
            return;
        }

        errorMessage = null;
        comparison = null;
        timeline = null;
        multiPlayerComparison = null;

        if (!AreDatesValid)
        {
            errorMessage =
                "La date de début doit précéder ou être égale à la date de fin.";

            return;
        }

        if (string.IsNullOrWhiteSpace(selectedCourse))
        {
            errorMessage =
                "Sélectionnez un circuit.";

            return;
        }

        if (isMultiPlayerMode)
        {
            if (!HasValidMultiPlayerSelection)
            {
                errorMessage =
                    "Sélectionnez entre deux et quatre joueurs.";

                return;
            }
        }
        else if (selectedPlayer is null)
        {
            errorMessage =
                "Sélectionnez un joueur.";

            return;
        }       

        loading = true;

        try
        {
            DateTimeOffset startAt =
                new(
                    startDate.Date
                        .AddDays(1)
                        .AddTicks(-1),
                    TimeSpan.Zero);

            DateTimeOffset endAt =
                new(
                    endDate.Date
                        .AddDays(1)
                        .AddTicks(-1),
                    TimeSpan.Zero);

            if (isMultiPlayerMode)
            {
                await AnalyzeMultiPlayerAsync(
                    startAt,
                    endAt);
            }
            else
            {
                await AnalyzeSinglePlayerAsync(
                    startAt,
                    endAt);
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                ex.Message;
        }
        finally
        {
            loading =
                false;
        }
    }

    private async Task AnalyzeSinglePlayerAsync(
    DateTimeOffset startAt,
    DateTimeOffset endAt)
    {
        HistoricalPlayerOption? player =
            selectedPlayer;

        if (player is null)
        {
            throw new InvalidOperationException(
                "Sélectionnez un joueur.");
        }

        comparison =
            await ComparisonService.CompareAsync(
                selectedCourse,
                selectedTimeType,
                selectedFrequency,
                startAt,
                endAt);

        timeline =
            await TimelineService.GetTimelineAsync(
                player,
                selectedCourse,
                selectedTimeType,
                selectedFrequency,
                startAt,
                endAt);
    }

    private async Task AnalyzeMultiPlayerAsync(
        DateTimeOffset startAt,
        DateTimeOffset endAt)
    {
        if (!HasValidMultiPlayerSelection)
        {
            throw new InvalidOperationException(
                "Sélectionnez entre deux et quatre joueurs.");
        }

        multiPlayerComparison =
            await MultiPlayerComparisonService.CompareAsync(
                selectedMultiPlayerIds.ToArray(),
                selectedCourse,
                selectedTimeType,
                selectedFrequency,
                startAt,
                endAt);
    }

    private static string FormatFrequency(
    HistoricalFrequencyFilter frequency) =>
    frequency switch
    {
        HistoricalFrequencyFilter.Hz50 =>
            "50 Hz",

        HistoricalFrequencyFilter.Hz60 =>
            "60 Hz",

        HistoricalFrequencyFilter.Unknown =>
            "Fréquence inconnue",

        _ =>
            "Toutes fréquences"
    };

    private static string FormatRank(int? rank) => rank is null ? "—" : $"#{rank}";

    private static string FormatRaceTime(TimeSpan? time) => time is null ? "—" : $"{(int)time.Value.TotalMinutes}:{time.Value.Seconds:00}.{time.Value.Milliseconds:000}";

    private static string FormatTimeImprovement(TimeSpan? improvement)
    {
        if (improvement is null)
            return "—";
        double milliseconds = Math.Round(improvement.Value.TotalMilliseconds);
        string sign = milliseconds > 0 ? "+" : milliseconds < 0 ? "-" : "";
        return $"{sign}{Math.Abs(milliseconds):0} ms";
    }

    private static string GetTimeImprovementClass(TimeSpan? improvement) =>
        improvement is null || improvement == TimeSpan.Zero
            ? "text-muted"
            : improvement > TimeSpan.Zero
                ? "text-success"
                : "text-danger";

    private static string GetPlacesClass(int? places) =>
        places is null || places == 0
            ? "text-muted"
            : places > 0
                ? "text-success"
                : "text-danger";

    private static string FormatPlaces(int? places) =>
        places is null
            ? "—"
            : places > 0
                ? $"+{places}"
                : places.Value.ToString();

    private static string GetSourceBadgeClass(string source) =>
        string.Equals(source, "MKDDTracker", StringComparison.OrdinalIgnoreCase)
            ? "text-bg-primary"
            : "text-bg-secondary";
}
