@page "/evolution"
@rendermode InteractiveServer

@using MKDDTracker.Web.Components.Charts
@using Microsoft.EntityFrameworkCore
@using MKDDTracker.Scraper.Data.Database
@using MKDDTracker.Scraper.Models.Evolution
@using MKDDTracker.Scraper.Services.EvolutionService

@inject MkddHistoricalRankingSelectionService SelectionService
@inject MkddHistoricalRankingComparisonService ComparisonService
@inject MkddHistoricalPlayerTimelineService TimelineService

<PageTitle>Évolution - MKDD Tracker</PageTitle>

<h1>Évolution des joueurs</h1>

<div class="card mb-4">
    <div class="card-body">
        <h4 class="mb-3">Critères d'analyse historique</h4>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Joueur</label>
                <select class="form-select" @bind="selectedPlayerKey" @bind:after="OnCriteriaChangedAsync">
                    @foreach (var player in players)
                    {
                        <option value="@player.Key">@player.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Circuit</label>
                <select class="form-select" @bind="selectedCourse" @bind:after="OnCriteriaChangedAsync">
                    @foreach (var course in courses)
                    {
                        <option value="@course">@course</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Type de chrono</label>
                <select class="form-select" @bind="selectedTimeType" @bind:after="OnCriteriaChangedAsync">
                    <option value="ThreeLap">ThreeLap</option>
                    <option value="Flap">Flap</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Fréquence</label>
                <select class="form-select" @bind="selectedFrequency" @bind:after="OnCriteriaChangedAsync">
                    <option value="@HistoricalFrequencyFilter.Hz50">50 Hz</option>
                    <option value="@HistoricalFrequencyFilter.Hz60">60 Hz</option>
                    <option value="@HistoricalFrequencyFilter.Unknown">Inconnue</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Date de début</label>
                <InputDate class="form-control" @bind-Value="startDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Date de fin</label>
                <InputDate class="form-control" @bind-Value="endDate" />
            </div>
            <div class="col-12">
                <button class="btn btn-primary" @onclick="AnalyzeAsync"
                        disabled="@(loading || availableHistoricalCount < 2 || !AreDatesValid)">
                    @(loading ? "Analyse en cours..." : "Analyser")
                </button>
            </div>
            <div class="col-12 text-muted">
                <strong>PR historiques disponibles :</strong> @availableHistoricalCount
                <div class="small">La date correspond à la première publication connue dans les archives Yahoo ; elle ne représente pas nécessairement la date de réalisation du chrono.</div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (loading)
{
    <p>Chargement de l'évolution...</p>
}
else if (comparison is null)
{
    <div class="alert alert-info">Sélectionnez des critères disposant d'au moins deux PR historiques.</div>
}
else
{
    var entry = selectedEntry;
    <h2>@(entry?.PlayerName ?? selectedPlayer?.DisplayName ?? "Joueur") — @comparison.CourseName</h2>

    @if (entry is null || entry.Status == MkddHistoricalRankingComparisonStatus.Unavailable)
    {
        <div class="alert alert-warning">Le classement historique n'est pas disponible pour ces critères.</div>
    }
    else
    {
        @if (entry.Status == MkddHistoricalRankingComparisonStatus.NewEntrant)
        {
            <div class="alert alert-info">Ce joueur est un nouveau entrant : il n'apparaît pas dans le classement initial.</div>
        }
        else if (entry.Status == MkddHistoricalRankingComparisonStatus.MissingAtEnd)
        {
            <div class="alert alert-warning">Ce joueur n'apparaît plus dans le classement final.</div>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-3"><div class="card h-100"><div class="card-body"><h6>Rang initial</h6><h2>@FormatRank(entry.InitialRank)</h2></div></div></div>
            <div class="col-md-3"><div class="card h-100"><div class="card-body"><h6>Rang final</h6><h2>@FormatRank(entry.FinalRank)</h2></div></div></div>
            <div class="col-md-3"><div class="card h-100"><div class="card-body"><h6>Progression totale</h6><h2>@FormatPlaces(entry.PlacesGained)</h2></div></div></div>
            <div class="col-md-3"><div class="card h-100"><div class="card-body"><h6>Chrono final</h6><h2>@FormatRaceTime(entry.FinalTime)</h2></div></div></div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5>Détail de la comparaison</h5>
                <p>Statut : <strong>@entry.Status</strong></p>
                <p>Rang : <strong>@FormatRank(entry.InitialRank) → @FormatRank(entry.FinalRank)</strong> (@FormatPlaces(entry.PlacesGained))</p>
                <p>Chrono : <strong>@FormatRaceTime(entry.InitialTime) → @FormatRaceTime(entry.FinalTime)</strong></p>
                <p>Temps gagné/perdu : <strong>@FormatTimeImprovement(entry.TimeImprovement)</strong></p>
            </div>
        </div>
    }

    <section class="mt-4">
        <h3>Évolution historique</h3>

        @if (timeline is null || timeline.Points.Count == 0)
        {
            <div class="alert alert-info">Aucun point de chronologie n'est disponible pour ces critères.</div>
        }
        else
        {
            <div class="table-responsive mb-4">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Chrono</th>
                            <th>Gain chrono</th>
                            <th>Rang</th>
                            <th>Variation de rang</th>
                            <th>Source(s)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in timeline.Points)
                        {
                            <tr>
                                <td>@point.Date.ToString("dd/MM/yyyy")</td>
                                <td>@FormatRaceTime(point.Time)</td>
                                <td class="@GetTimeImprovementClass(point.TimeImprovement)">
                                    @FormatTimeImprovement(point.TimeImprovement)
                                </td>
                                <td>#@point.Rank</td>
                                <td class="@GetPlacesClass(point.PlacesGained)">
                                    @FormatPlaces(point.PlacesGained)
                                </td>
                                <td>
                                    @foreach (string source in point.Sources)
                                    {
                                        <span class="badge @GetSourceBadgeClass(source) me-1">@source</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (timeline.Points.Count == 1)
            {
                <p class="text-muted">Un seul point est disponible : il n'y a pas suffisamment d'évolution pour tracer une progression.</p>
            }
            else
            {
                <MkddHistoricalTimeEvolutionChart Points="timeline.Points" />
                <MkddHistoricalRankEvolutionChart Points="timeline.Points" />
            }
        }
    </section>
}

@code {
    private List<HistoricalPlayerOption> players = [];
    private List<string> courses = [];
    private string selectedPlayerKey = "";
    private string selectedCourse = "";
    private string selectedTimeType = "ThreeLap";
    private HistoricalFrequencyFilter selectedFrequency = HistoricalFrequencyFilter.Hz60;
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today;
    private int availableHistoricalCount;
    private MkddHistoricalRankingComparison? comparison;
    private MkddHistoricalPlayerTimeline? timeline;
    private bool loading;
    private string? errorMessage;

    [SupplyParameterFromQuery(Name = "player")]
    private string? PlayerFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "course")]
    private string? CourseFromQuery { get; set; }

    private HistoricalPlayerOption? selectedPlayer =>
        players.FirstOrDefault(player => player.Key == selectedPlayerKey);

    private MkddHistoricalRankingComparisonEntry? selectedEntry =>
        comparison?.Entries.FirstOrDefault(entry =>
            selectedPlayer?.PlayerId is not null
                ? entry.PlayerId == selectedPlayer.PlayerId
                : entry.HistoricalPlayerAliasId == selectedPlayer?.HistoricalPlayerAliasId);

    private bool AreDatesValid => startDate.Date <= endDate.Date;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            players = await SelectionService.GetPlayersAsync();
            courses = await SelectionService.GetCoursesAsync();
            selectedPlayerKey = ResolvePlayerKey(PlayerFromQuery) ?? players.FirstOrDefault()?.Key ?? "";
            selectedCourse = courses.Contains(CourseFromQuery ?? "")
                ? CourseFromQuery!
                : courses.FirstOrDefault() ?? "";
            await LoadAvailableDatesAsync();
            if (availableHistoricalCount >= 2)
                await AnalyzeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private string? ResolvePlayerKey(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        return players.FirstOrDefault(player =>
            string.Equals(player.Key, value, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(player.DisplayName, value, StringComparison.OrdinalIgnoreCase))?.Key;
    }

    private async Task OnCriteriaChangedAsync()
    {
        errorMessage = null;
        comparison = null;
        timeline = null;
        await LoadAvailableDatesAsync();
    }

    private async Task LoadAvailableDatesAsync()
    {
        availableHistoricalCount = 0;
        if (selectedPlayer is null || string.IsNullOrWhiteSpace(selectedCourse))
            return;

        HistoricalPerformanceDateRange range = await SelectionService.GetDateRangeAsync(
            selectedPlayer, selectedCourse, selectedTimeType, selectedFrequency);
        availableHistoricalCount = range.Count;
        if (range.FirstSeenAt is not null && range.LastSeenAt is not null)
        {
            startDate = range.FirstSeenAt.Value.Date;
            endDate = range.LastSeenAt.Value.Date;
        }
    }

    private async Task AnalyzeAsync()
    {
        if (loading)
            return;

        errorMessage = null;
        comparison = null;
        timeline = null;
        HistoricalPlayerOption? player = selectedPlayer;
        if (player is null || string.IsNullOrWhiteSpace(selectedCourse))
        {
            errorMessage = "Sélectionnez un joueur et un circuit.";
            return;
        }
        if (!AreDatesValid)
        {
            errorMessage = "La date de début doit précéder la date de fin.";
            return;
        }

        loading = true;
        try
        {
            DateTimeOffset startAt =
                new(
                    startDate.Date
                        .AddDays(1)
                        .AddTicks(-1),
                    TimeSpan.Zero);

            DateTimeOffset endAt =
                new(
                    endDate.Date
                        .AddDays(1)
                        .AddTicks(-1),
                    TimeSpan.Zero);

            comparison =
                await ComparisonService.CompareAsync(
                    selectedCourse,
                    selectedTimeType,
                    selectedFrequency,
                    startAt,
                    endAt);

            timeline = await TimelineService.GetTimelineAsync(
                player,
                selectedCourse,
                selectedTimeType,
                selectedFrequency,
                startAt,
                endAt);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static string FormatRank(int? rank) => rank is null ? "—" : $"#{rank}";

    private static string FormatRaceTime(TimeSpan? time) => time is null ? "—" : $"{(int)time.Value.TotalMinutes}:{time.Value.Seconds:00}.{time.Value.Milliseconds:000}";

    private static string FormatTimeImprovement(TimeSpan? improvement)
    {
        if (improvement is null)
            return "—";
        double milliseconds = Math.Round(improvement.Value.TotalMilliseconds);
        string sign = milliseconds > 0 ? "+" : milliseconds < 0 ? "-" : "";
        return $"{sign}{Math.Abs(milliseconds):0} ms";
    }

    private static string GetTimeImprovementClass(TimeSpan? improvement) =>
        improvement is null || improvement == TimeSpan.Zero
            ? "text-muted"
            : improvement > TimeSpan.Zero
                ? "text-success"
                : "text-danger";

    private static string GetPlacesClass(int? places) =>
        places is null || places == 0
            ? "text-muted"
            : places > 0
                ? "text-success"
                : "text-danger";

    private static string FormatPlaces(int? places) =>
        places is null
            ? "—"
            : places > 0
                ? $"+{places}"
                : places.Value.ToString();

    private static string GetSourceBadgeClass(string source) =>
        string.Equals(source, "MKDDTracker", StringComparison.OrdinalIgnoreCase)
            ? "text-bg-primary"
            : "text-bg-secondary";
}
