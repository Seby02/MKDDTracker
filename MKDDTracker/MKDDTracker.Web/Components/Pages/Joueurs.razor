@page "/joueurs"
@rendermode InteractiveServer

@using MKDDTracker.Scraper.Models.Evolution
@using MKDDTracker.Scraper.Services.EvolutionService

@inject MkddHistoricalRankingSelectionService SelectionService
@inject MkddHistoricalPlayerProfileService ProfileService

<PageTitle>Profils des joueurs - MKDD Tracker</PageTitle>

<h1>Profils des joueurs</h1>
<p class="text-muted">Carrières reconstruites à partir des performances historiques.</p>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="player-search">Rechercher un joueur ou un alias historique</label>
                <input id="player-search" class="form-control" @bind="searchText" @bind:event="oninput"
                       placeholder="Nom moderne ou alias Yahoo..." />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="player-select">Sélectionner un joueur</label>
                <select id="player-select" class="form-select" value="@selectedPlayerKey" @onchange="OnPlayerChanged">
                    <option value="">-- Choisir un joueur --</option>
                    @foreach (PlayerListItem item in FilteredPlayers)
                    {
                        <option value="@item.Option.Key">@item.Option.DisplayName — @(item.Option.PlayerId is not null ? "Joueur MKDDTracker" : "Alias historique")</option>
                    }
                </select>
            </div>
        </div>
        <p class="text-muted mt-3 mb-0">@FilteredPlayers.Count() joueur(s) trouvé(s)</p>
    </div>
</div>

@if (loading)
{
    <p>Chargement du profil historique...</p>
}
else if (playerItems.Count == 0)
{
    <div class="alert alert-info">Aucun joueur historique n'est disponible.</div>
}
else if (selectedPlayer is null)
{
    <div class="alert alert-info">Sélectionnez un joueur pour afficher sa carrière historique.</div>
}
else
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h2 class="mb-0">@selectedPlayer.DisplayName</h2>
                @if (selectedPlayer.IsLinkedToModernPlayer)
                {
                    <span class="badge text-bg-primary">Joueur MKDDTracker</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Alias historique</span>
                }
            </div>
            <p class="text-muted mb-3">Pays : @(selectedPlayer.Country ?? "Non renseigné")</p>
            <div class="row g-3">
                <div class="col-sm-6 col-lg-3"><div class="p-3 bg-light rounded"><h6>Circuits couverts</h6><h3>@selectedPlayer.DistinctCoursesCount</h3></div></div>
                <div class="col-sm-6 col-lg-3"><div class="p-3 bg-light rounded"><h6>Événements historiques</h6><h3>@selectedPlayer.TotalHistoricalEvents</h3></div></div>
                <div class="col-sm-6 col-lg-3"><div class="p-3 bg-light rounded"><h6>Première performance connue</h6><div>@FormatDate(selectedPlayer.FirstKnownPerformanceAt)</div></div></div>
                <div class="col-sm-6 col-lg-3"><div class="p-3 bg-light rounded"><h6>Dernière performance connue</h6><div>@FormatDate(selectedPlayer.LastKnownPerformanceAt)</div></div></div>
            </div>
            <p class="mt-3 mb-1"><strong>Alias historiques consolidés :</strong> @selectedPlayer.AliasNames.Count</p>
            @if (selectedPlayer.AliasNames.Count > 0)
            {
                <div>
                    @foreach (string alias in selectedPlayer.AliasNames)
                    {
                        <span class="badge text-bg-light border me-1">@alias</span>
                    }
                </div>
            }
        </div>
    </div>

    <p class="small text-muted">Les dates correspondent aux premières observations connues dans les sources historiques et ne représentent pas nécessairement les dates exactes de réalisation.</p>

    @if (selectedPlayer.Categories.Count == 0)
    {
        <div class="alert alert-info">Ce joueur ne possède aucune performance historique exploitable.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Circuit</th>
                        <th>Type</th>
                        <th>Fréquence</th>
                        <th>Premier chrono connu</th>
                        <th>Meilleur chrono actuel</th>
                        <th>Gain total</th>
                        <th>Rang actuel</th>
                        <th>Joueurs classés</th>
                        <th>Première date</th>
                        <th>Dernière date</th>
                        <th>Sources</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MkddHistoricalPlayerCategorySummary category in selectedPlayer.Categories)
                    {
                        <tr>
                            <td>@category.CourseName</td>
                            <td>@category.TimeType</td>
                            <td><span class="badge text-bg-light border">@FormatFrequency(category.FrequencyFilter)</span></td>
                            <td>@FormatTime(category.FirstKnownTime)</td>
                            <td>@FormatTime(category.CurrentBestTime)</td>
                            <td class="@(category.Improvement > TimeSpan.Zero ? "text-success" : "text-muted")">@FormatImprovement(category.Improvement)</td>
                            <td>@(category.CurrentRank is null ? "—" : $"#{category.CurrentRank}")</td>
                            <td>@(category.RankedPlayerCount?.ToString() ?? "—")</td>
                            <td>@FormatDate(category.FirstKnownAt)</td>
                            <td>@FormatDate(category.LastKnownAt)</td>
                            <td>
                                @foreach (string source in category.Sources)
                                {
                                    <span class="badge @(GetSourceBadgeClass(source)) me-1">@source</span>
                                }
                            </td>
                            <td><a class="btn btn-sm btn-outline-primary" href="@GetEvolutionUrl(category)">Voir l’évolution</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "player")]
    private string? PlayerFromQuery { get; set; }

    private List<PlayerListItem> playerItems = [];
    private MkddHistoricalPlayerProfile? selectedPlayer;
    private string selectedPlayerKey = "";
    private string searchText = "";
    private string? errorMessage;
    private bool loading = true;

    private IEnumerable<PlayerListItem> FilteredPlayers => playerItems.Where(item =>
        string.IsNullOrWhiteSpace(searchText) ||
        item.Option.DisplayName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
        item.AliasNames.Any(alias => alias.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            List<HistoricalPlayerOption> players = await SelectionService.GetPlayersAsync();
            Dictionary<string, IReadOnlyList<string>> aliases = await ProfileService.GetAliasNamesAsync(players);
            playerItems = players
                .Select(player => new PlayerListItem(
                    player,
                    aliases.TryGetValue(player.Key, out IReadOnlyList<string>? names) ? names : []))
                .ToList();

            PlayerListItem? requestedPlayer = ResolvePlayer(PlayerFromQuery);
            if (requestedPlayer is not null)
            {
                selectedPlayerKey = requestedPlayer.Option.Key;
                searchText = requestedPlayer.Option.DisplayName;
                await LoadPlayerAsync();
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private PlayerListItem? ResolvePlayer(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        return playerItems.FirstOrDefault(item =>
                   string.Equals(item.Option.Key, value, StringComparison.OrdinalIgnoreCase))
               ?? playerItems.FirstOrDefault(item =>
                   item.Option.PlayerId is not null &&
                   string.Equals(item.Option.DisplayName, value, StringComparison.OrdinalIgnoreCase))
               ?? playerItems.FirstOrDefault(item =>
                   item.Option.PlayerId is null &&
                   string.Equals(item.Option.DisplayName, value, StringComparison.OrdinalIgnoreCase))
               ?? playerItems.FirstOrDefault(item => item.AliasNames.Any(alias =>
                   string.Equals(alias, value, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task OnPlayerChanged(ChangeEventArgs args)
    {
        selectedPlayerKey = args.Value?.ToString() ?? "";
        await LoadPlayerAsync();
    }

    private async Task LoadPlayerAsync()
    {
        selectedPlayer = null;
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(selectedPlayerKey))
            return;

        loading = true;
        try
        {
            PlayerListItem? item = playerItems.FirstOrDefault(player => player.Option.Key == selectedPlayerKey);
            if (item is not null)
                selectedPlayer = await ProfileService.GetProfileAsync(item.Option);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private string GetEvolutionUrl(MkddHistoricalPlayerCategorySummary category)
    {
        string player = Uri.EscapeDataString(selectedPlayer?.PlayerKey ?? "");
        string course = Uri.EscapeDataString(category.CourseName);
        string type = Uri.EscapeDataString(category.TimeType);
        string frequency = Uri.EscapeDataString(category.FrequencyFilter.ToString());
        return $"/evolution?player={player}&course={course}&type={type}&frequency={frequency}";
    }

    private static string FormatFrequency(HistoricalFrequencyFilter frequency) => frequency switch
    {
        HistoricalFrequencyFilter.Hz50 => "50 Hz",
        HistoricalFrequencyFilter.Hz60 => "60 Hz",
        _ => "Inconnue"
    };

    private static string FormatDate(DateTimeOffset? date) => date?.ToString("dd/MM/yyyy") ?? "—";

    private static string FormatTime(TimeSpan time) =>
        $"{(int)time.TotalMinutes}:{time.Seconds:00}.{time.Milliseconds:000}";

    private static string FormatImprovement(TimeSpan improvement)
    {
        double milliseconds = Math.Round(improvement.TotalMilliseconds);
        return milliseconds > 0 ? $"+{milliseconds:0} ms" : $"{milliseconds:0} ms";
    }

    private static string GetSourceBadgeClass(string source) =>
        string.Equals(source, "MKDDTracker", StringComparison.OrdinalIgnoreCase)
            ? "text-bg-primary"
            : "text-bg-secondary";

    private sealed record PlayerListItem(
        HistoricalPlayerOption Option,
        IReadOnlyList<string> AliasNames);
}
