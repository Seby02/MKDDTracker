@page "/joueurs"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MKDDTracker.Scraper.Data.Database

@inject IDbContextFactory<MkddDbContext> DbFactory

<PageTitle>Joueurs - MKDD Tracker</PageTitle>

<h1>Profils des joueurs</h1>

<p class="text-muted">
    Retrouvez les performances d'un joueur sur tous les circuits.
</p>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Rechercher un joueur</label>
                <input class="form-control"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Nom du joueur..." />
            </div>

            <div class="col-md-6">
                <label class="form-label">Sélectionner un joueur</label>
                <select class="form-select"
                        value="@selectedPlayerId"
                        @onchange="OnPlayerChanged">
                    <option value="0">-- Choisir un joueur --</option>

                    @foreach (var player in FilteredPlayers)
                    {
                        <option value="@player.Id">
                            @player.Name
                        </option>
                    }
                </select>
            </div>

        </div>

        <p class="text-muted mt-3 mb-0">
            @FilteredPlayers.Count() joueur(s) trouvé(s)
        </p>
    </div>
</div>

@if (loading)
{
    <p>Chargement...</p>
}
else if (selectedPlayer is not null)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">

            <h2>@selectedPlayer.Name</h2>

            <p class="text-muted">
                Pays : @(selectedPlayer.Country ?? "Non renseigné")
            </p>

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded">
                        <h6>Circuits</h6>
                        <h3>@courseStats.Count</h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded">
                        <h6>Performances historiques</h6>
                        <h3>@performanceCount</h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded">
                        <h6>Meilleur rang observé</h6>
                        <h3>
                            @(courseStats.Count == 0
                                                    ? "—"
                                                    : $"#{courseStats.Min(x => x.BestRank)}")
                    </h3>
                </div>
            </div>

            </div>
        </div>
    </div>

    <h3>Performances par circuit</h3>

@if (courseStats.Count == 0)
    {
        <div class="alert alert-info">
            Aucune performance enregistrée pour ce joueur.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Circuit</th>
                        <th>Meilleur rang</th>
                        <th>Meilleur chrono</th>
                        <th>Dernier rang</th>
                        <th>Dernier chrono</th>
                        <th>Dernière date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in courseStats)
                    {
                        <tr>
                            <td><strong>@stat.CourseName</strong></td>
                            <td>#@stat.BestRank</td>
                            <td>@FormatTime(stat.BestTime)</td>
                            <td>#@stat.LatestRank</td>
                            <td>@FormatTime(stat.LatestTime)</td>
                            <td>
                                @stat.LatestDate.ToString("dd/MM/yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}


@if (courseStats.Count > 0)
{
    <div class="card mt-4 mb-4 shadow-sm">
        <div class="card-body">

            <h3 class="mb-3">Historique des performances</h3>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Circuit</label>

                    <select class="form-select"
                            @bind="selectedHistoryCourseId">
                        @foreach (var course in courseStats)
                        {
                            <option value="@course.CourseId">
                                @course.CourseName
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    @{
                        var currentCourse = courseStats
                        .FirstOrDefault(x =>
                        x.CourseId == selectedHistoryCourseId);
                    }

                    @if (currentCourse is not null)
                    {
                        <a class="btn btn-primary"
                           href="@GetEvolutionUrl(currentCourse.CourseName)">
                            Voir l'évolution
                        </a>
                    }
                </div>
            </div>

            @{
                var history = FilteredHistory;
            }

            @if (history.Count == 0)
            {
                <p class="text-muted">
                    Aucun historique disponible pour ce circuit.
                </p>
            }
            else
            {
                <p class="text-muted">
                    @history.Count snapshot(s) enregistré(s)
                </p>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Rang</th>
                                <th>Évolution du rang</th>
                                <th>Chrono</th>
                                <th>Évolution du chrono</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < history.Count; i++)
                            {
                                var current = history[i];

                                PlayerPerformance? previous =
                                i > 0 ? history[i - 1] : null;

                                <tr>
                                    <td>
                                        @current.Date.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <strong>@($"#{current.Rank}")</strong>
                                    </td>

                                    <td>
                                        @if (previous is null)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            var placesGained =
                                            previous.Rank - current.Rank;

                                            if (placesGained > 0)
                                            {
                                                <span class="text-success">
                                                    ▲ +@placesGained
                                                </span>
                                            }
                                            else if (placesGained < 0)
                                            {
                                                <span class="text-danger">
                                                    ▼ @placesGained
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">=</span>
                                            }
                                        }
                                    </td>

                                    <td>@FormatTime(current.Time)</td>

                                    <td>
                                        @if (previous is null)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            var millisecondsGained =
                                            (previous.Time - current.Time)
                                            .TotalMilliseconds;

                                            if (millisecondsGained > 0)
                                            {
                                                <span class="text-success">
                                                    ▲ @millisecondsGained.ToString("0") ms gagnées
                                                </span>
                                            }
                                            else if (millisecondsGained < 0)
                                            {
                                                <span class="text-danger">
                                                    ▼ @Math.Abs(millisecondsGained).ToString("0") ms perdues
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Chrono inchangé
                                                </span>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}


@code {

    [SupplyParameterFromQuery(Name = "player")]
    private string? PlayerFromQuery { get; set; }

    private List<PlayerOption> players = [];
    private List<CourseStats> courseStats = [];

    private PlayerOption? selectedPlayer;

    private int selectedPlayerId;
    private int performanceCount;

    private string searchText = "";
    private string? errorMessage;
    private bool loading = true;

    private List<PlayerPerformance> playerHistory = [];

    private int selectedHistoryCourseId;

    private List<PlayerPerformance> FilteredHistory =>
        playerHistory
            .Where(x => x.CourseId == selectedHistoryCourseId)
            .OrderBy(x => x.Date)
            .ThenBy(x => x.SnapshotId)
            .ToList();

    private IEnumerable<PlayerOption> FilteredPlayers =>
        players.Where(x =>
            string.IsNullOrWhiteSpace(searchText) ||
            x.Name.Contains(
                searchText,
                StringComparison.OrdinalIgnoreCase));

    private string GetEvolutionUrl(string courseName)
    {
        if (selectedPlayer is null)
            return "/evolution";

        var player = Uri.EscapeDataString(selectedPlayer.Name);
        var course = Uri.EscapeDataString(courseName);

        return $"/evolution?player={player}&course={course}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            players = await db.Players
                .AsNoTracking()
                .OrderBy(x => x.Name)
                .Select(x => new PlayerOption(
                    x.Id,
                    x.Name,
                    x.Country))
                .ToListAsync();

            if (!string.IsNullOrWhiteSpace(PlayerFromQuery))
            {
                var matchingPlayer = players.FirstOrDefault(
                    x => string.Equals(
                        x.Name,
                        PlayerFromQuery,
                        StringComparison.OrdinalIgnoreCase));

                if (matchingPlayer is not null)
                {
                    selectedPlayerId = matchingPlayer.Id;
                    searchText = matchingPlayer.Name;

                    await LoadPlayerAsync();
                }
            }


        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnPlayerChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id))
            return;

        selectedPlayerId = id;
        await LoadPlayerAsync();
    }

    private async Task LoadPlayerAsync()
    {
        loading = true;
        errorMessage = null;

        selectedPlayer = null;
        courseStats = [];
        playerHistory = [];
        selectedHistoryCourseId = 0;
        performanceCount = 0;

        try
        {
            if (selectedPlayerId == 0)
                return;

            selectedPlayer = players.FirstOrDefault(
                x => x.Id == selectedPlayerId);

            if (selectedPlayer is null)
                return;

            await using var db =
                await DbFactory.CreateDbContextAsync();

            // Jointures explicites entre performances,
            // snapshots et circuits.
            var performances = await (
                from p in db.Performances.AsNoTracking()
                join s in db.Snapshots.AsNoTracking()
                    on p.SnapshotId equals s.Id
                join c in db.Courses.AsNoTracking()
                    on s.CourseId equals c.Id
                where p.PlayerId == selectedPlayerId
                select new PlayerPerformance(
                    c.Id,
                    c.Name,
                    s.Id,
                    s.RankingDate,
                    p.Rank,
                    p.Time)
            ).ToListAsync();

            performanceCount = performances.Count;

            courseStats = performances
                .GroupBy(x => new
                    {
                        x.CourseId,
                        x.CourseName
                    })
                .Select(group =>
                {
                    var latest = group
                        .OrderByDescending(x => x.Date)
                        .ThenByDescending(x => x.SnapshotId)
                        .First();

                    return new CourseStats(
                        group.Key.CourseId,
                        group.Key.CourseName,
                        group.Min(x => x.Rank),
                        group.Min(x => x.Time),
                        latest.Rank,
                        latest.Time,
                        latest.Date);
                })
                .OrderBy(x => x.CourseName)
                .ToList();

            selectedHistoryCourseId = courseStats.FirstOrDefault()?.CourseId ?? 0;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static string FormatTime(TimeSpan time)
    {
        return $"{(int)time.TotalMinutes}:{time.Seconds:00}.{time.Milliseconds:000}";
    }

    private sealed record PlayerOption(
        int Id,
        string Name,
        string? Country);

    private sealed record PlayerPerformance(
        int CourseId,
        string CourseName,
        int SnapshotId,
        DateOnly Date,
        int Rank,
        TimeSpan Time);

    private sealed record CourseStats(
        int CourseId,
        string CourseName,
        int BestRank,
        TimeSpan BestTime,
        int LatestRank,
        TimeSpan LatestTime,
        DateOnly LatestDate);
}
