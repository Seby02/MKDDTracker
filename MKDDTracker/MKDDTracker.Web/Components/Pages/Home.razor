@page "/"
@rendermode InteractiveServer

@using MKDDTracker.Scraper.Models.Dashboard
@using MKDDTracker.Scraper.Services.Dashboard

@inject MkddHistoricalDashboardService DashboardService

<PageTitle>Accueil - MKDD Tracker</PageTitle>

<div class="mb-4">
    <h1>🏁 MKDD Tracker</h1>
    <p class="text-muted">
        Tableau de bord des classements Mario Kart: Double Dash!!
    </p>
</div>

@if (loading)
{
    <p>Chargement du tableau de bord...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (dashboard is null)
{
    <p>Aucune donnée historique disponible.</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h6 class="text-muted">Performances historiques</h6>
                <h2 class="mb-0">@dashboard.TotalPerformanceCount</h2>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h6 class="text-muted">Identités historiques</h6>
                <h2 class="mb-0">@dashboard.HistoricalIdentityCount</h2>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h6 class="text-muted">Joueurs modernes reliés</h6>
                <h2 class="mb-0">@dashboard.ModernLinkedPlayerCount</h2>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h6 class="text-muted">Circuits avec historique</h6>
                <h2 class="mb-0">@dashboard.CourseCount</h2>
            </div></div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h5 class="card-title">Période historique</h5>
                <div>Première date historique plausible : <strong>@FormatDate(dashboard.FirstSeenAt)</strong></div>
                <div>Dernière date historique : <strong>@FormatDate(dashboard.LastSeenAt)</strong></div>
            </div></div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm"><div class="card-body">
                <h5 class="card-title">Sources</h5>
                <div>Yahoo Groups : <strong>@dashboard.YahooGroupsCount</strong></div>
                <div>MKDDTracker : <strong>@dashboard.MkddTrackerCount</strong></div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card h-100"><div class="card-body">
                <h6 class="card-title">Type de performance</h6>
                <div>ThreeLap : <strong>@dashboard.ThreeLapCount</strong></div>
                <div>Flap : <strong>@dashboard.FlapCount</strong></div>
            </div></div>
        </div>
        <div class="col-md-8">
            <div class="card h-100"><div class="card-body">
                <h6 class="card-title">Fréquence</h6>
                <div class="d-flex flex-wrap gap-3">
                    <span>50 Hz : <strong>@dashboard.Hz50Count</strong></span>
                    <span>60 Hz : <strong>@dashboard.Hz60Count</strong></span>
                    <span>Inconnue : <strong>@dashboard.UnknownFrequencyCount</strong></span>
                </div>
            </div></div>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">Activité historique récente</h5>
            @if (dashboard.RecentEvents.Count == 0)
            {
                <p class="text-muted">
                    Aucune performance historique disponible.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Joueur</th>
                                <th>Circuit</th>
                                <th>Type</th>
                                <th>Fréquence</th>
                                <th>Chrono</th>
                                <th>Source</th>
                                <th>Navigation</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (MkddHistoricalDashboardEvent historicalEvent in dashboard.RecentEvents)
                            {
                                <tr>
                                    <td>@FormatDate(historicalEvent.FirstSeenAt)</td>
                                    <td><a href="@GetPlayerUrl(historicalEvent)">@historicalEvent.PlayerName</a></td>
                                    <td>@historicalEvent.CourseName</td>
                                    <td>@historicalEvent.TimeType</td>
                                    <td>@FormatFrequency(historicalEvent.Frequency)</td>
                                    <td>@FormatTime(historicalEvent.Time)</td>
                                    <td>@string.Join(" + ", historicalEvent.Sources)</td>
                                    <td class="text-nowrap">
                                        <a class="btn btn-sm btn-outline-secondary me-1" href="@GetRankingUrl(historicalEvent)">Classement</a>
                                        <a class="btn btn-sm btn-outline-primary" href="@GetEvolutionUrl(historicalEvent)">Évolution</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

    <!-- Accès rapide -->
    <h4 class="mb-3">Accès rapide</h4>

    <div class="row g-3">

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5>📥 Importer</h5>
                    <p class="text-muted">
                        Ajouter un nouveau classement HTML.
                    </p>
                    <a href="/import"
                       class="btn btn-primary">
                        Importer
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5>🏆 Classements</h5>
                    <p class="text-muted">
                        Consulter les joueurs et leurs chronos.
                    </p>
                    <a href="/ranking"
                       class="btn btn-primary">
                        Consulter
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5>📈 Évolution</h5>
                    <p class="text-muted">
                        Analyser les rangs et les chronos dans le temps.
                    </p>
                    <a href="/evolution"
                       class="btn btn-primary">
                        Analyser
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5>👤 Joueurs</h5>
                    <p class="text-muted">
                        Consulter les performances par joueur.
                    </p>
                    <a href="/joueurs" class="btn btn-primary">
                        Voir les joueurs
                    </a>
                </div>
            </div>
        </div>

    </div>
}

@code {
    private bool loading = true;
    private string? errorMessage;
    private MkddHistoricalDashboard? dashboard;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            dashboard = await DashboardService.GetDashboardAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static string FormatDate(DateTimeOffset? date) =>
        date?.ToUniversalTime().ToString("dd/MM/yyyy") ?? "—";

    private static string FormatDate(DateTimeOffset date) =>
        date.ToUniversalTime().ToString("dd/MM/yyyy");

    private static string FormatFrequency(int? frequency) => frequency switch
    {
        50 => "50 Hz",
        60 => "60 Hz",
        _ => "Inconnue"
    };

    private static string FormatTime(TimeSpan time) =>
        $"{(int)time.TotalMinutes}:{time.Seconds:00}.{time.Milliseconds:000}";

    private static string GetPlayerUrl(MkddHistoricalDashboardEvent historicalEvent) =>
        $"/joueurs?player={Uri.EscapeDataString(historicalEvent.PlayerKey)}";

    private static string GetRankingUrl(MkddHistoricalDashboardEvent historicalEvent) =>
        "/ranking?" +
        $"course={Uri.EscapeDataString(historicalEvent.CourseName)}&" +
        $"type={Uri.EscapeDataString(historicalEvent.TimeType)}&" +
        $"frequency={Uri.EscapeDataString(FormatFrequencyQueryValue(historicalEvent.Frequency))}";

    private static string GetEvolutionUrl(MkddHistoricalDashboardEvent historicalEvent) =>
        "/evolution?" +
        $"player={Uri.EscapeDataString(historicalEvent.PlayerKey)}&" +
        $"course={Uri.EscapeDataString(historicalEvent.CourseName)}&" +
        $"type={Uri.EscapeDataString(historicalEvent.TimeType)}&" +
        $"frequency={Uri.EscapeDataString(FormatFrequencyQueryValue(historicalEvent.Frequency))}";

    private static string FormatFrequencyQueryValue(int? frequency) => frequency switch
    {
        50 => "Hz50",
        60 => "Hz60",
        _ => "Unknown"
    };
}
